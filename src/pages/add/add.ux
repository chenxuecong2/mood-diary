    background-color: #000000;
  }

  .form {
    flex-direction: column;
  }

  .head {
    flex-direction: row;
    align-items: center;
  }

  /* 返回键：三个页面同一尺寸、同一配色 */
  .back {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    align-items: center;
    justify-content: center;
    background-color: #1a2530;
    margin-right: 16px;
  }

  .back-icon {
    font-size: 40px;
    color: #ffffff;
    line-height: 40px;
  }

  .title {
    font-size: 32px;
    color: #ffffff;
    font-weight: bold;
  }

  .ask-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 28px;
  }

  .ask {
    font-size: 30px;
    color: #ffffff;
  }

  .face {
    width: 78px;
    height: 78px;
  }

  .mood-name {
    font-size: 20px;
    color: #edc14a;
    text-align: right;
    margin-top: 4px;
  }

  .date-row {
    height: 52px;
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
  }

  .date-btn {
    width: 52px;
    height: 52px;
    border-radius: 26px;
    align-items: center;
    justify-content: center;
    background-color: #1a2530;
  }

  .date-arrow {
    font-size: 34px;
    color: #ffffff;
    line-height: 38px;
  }

  .date-text {
    flex: 1;
    font-size: 26px;
    color: #edc14a;
    text-align: center;
  }

  .phrase {
    flex-direction: column;
    margin-top: 30px;
  }

  .phrase-text {
    font-size: 26px;
    color: #8a8a8a;
    lines: 1;
    text-overflow: ellipsis;
  }

  .phrase-on {
    color: #ffffff;
  }

  .underline {
    height: 3px;
    border-radius: 2px;
    background-color: #14c8b4;
    margin-top: 8px;
  }

  .typing {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .typing-text {
    flex: 1;
    font-size: 28px;
    color: #8a8a8a;
    lines: 1;
    text-overflow: ellipsis;
    margin-right: 16px;
  }

  .typing-on {
    color: #ffffff;
  }

  .typing-done {
    font-size: 26px;
    color: #14c8b4;
  }

  .actions {
    flex-direction: row;
    align-items: center;
  }

  .btn {
    flex: 1;
    height: 78px;
    border-radius: 39px;
    align-items: center;
    justify-content: center;
  }

  .btn-cancel {
    background-color: #333333;
  }

  .btn-save {
    background-color: #f5c842;
    margin-left: 16px;
  }

  .btn-cancel-text {
    font-size: 28px;
    color: #e8e8e8;
  }

  .btn-save-text {
    font-size: 28px;
    color: #ffffff;
    font-weight: bold;
  }
</style>
